{
  "name": "@kindyroo/codex-sessions",
  "version": "0.4.1",
  "description": "Local dashboard and CLI for managing Codex sessions across model providers.",
  "author": "zhujinrun <zhujr@shinetechsoftware.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codex-sessions": "./bin/codex-sessions.js"
  },
  "files": [
    "bin",
    "backend",
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/zhujinrun/codex-sessions.git"
  },
  "bugs": {
    "url": "https://gitee.com/zhujinrun/codex-sessions/issues"
  },
  "homepage": "https://gitee.com/zhujinrun/codex-sessions#readme",
  "scripts": {
    "build": "vite build",
    "check": "vue-tsc --noEmit",
